# ============================================================
# ZSC-TSD local environment template
#
# Copy this file to ".env" and fill in local values.
# Never commit the real ".env" file.
# ============================================================


# ------------------------------------------------------------
# Cryptographic key
#
# Must be a Base64-encoded 32-byte key for AES-256-GCM.
# Leave empty in this template.
# ------------------------------------------------------------

ZSC_TSD_KEY_B64=


# ------------------------------------------------------------
# Project paths
# Use absolute paths on the experiment computer when possible.
# ------------------------------------------------------------

ZSC_TSD_PROJECT_ROOT=
ZSC_TSD_RUN_ROOT=artifacts/new_e2e


# ------------------------------------------------------------
# Hugging Face cache
# ------------------------------------------------------------

HF_HOME=
TRANSFORMERS_CACHE=


# ------------------------------------------------------------
# Frozen ZTS model paths
# These must point to the same model/tokenizer versions used
# by the original paper experiments.
# ------------------------------------------------------------

ZSC_TSD_LLM_MODEL_PATH=
ZSC_TSD_LLM_TOKENIZER_PATH=
ZSC_TSD_PLAINTEXT_CODEC_MODEL_PATH=


# ------------------------------------------------------------
# TTS configuration
# Fill these only after the original checkpoint is confirmed.
# ------------------------------------------------------------

ZSC_TSD_TTS_BACKEND=
ZSC_TSD_TTS_CHECKPOINT_DIR=
ZSC_TSD_TTS_CONFIG_PATH=


# ------------------------------------------------------------
# ASR configuration
# This is for the newly added receiver-side pipeline.
# ------------------------------------------------------------

ZSC_TSD_ASR_BACKEND=
ZSC_TSD_ASR_MODEL_PATH=


# ------------------------------------------------------------
# VoIP configuration
# Not used in the first local end-to-end stage.
# ------------------------------------------------------------

ZSC_TSD_SIP_SERVER=
ZSC_TSD_SIP_USERNAME=
ZSC_TSD_SIP_PASSWORD=
